<%- include('../partials/head') %>
<%
  const company = settings.company || {};
  const S = L.store;
  const bySlug = {};
  products.forEach(function (p) { bySlug[p.slug] = p; });
  const tabCats = categories.filter(function (c) { return c.product_count > 0; });
  const zaloHref = company.zalo ? 'https://zalo.me/' + company.zalo : url('/contact');
%>

<%
  const TXT = {
    vi: { eyebrow: 'Thủy Sản Tím', title: 'Tinh hoa sinh học,', em: 'vững vàng mùa vụ.', lead: 'Chế phẩm sinh học và dinh dưỡng cho ao nuôi tôm, cá. Kỹ thuật viên tư vấn miễn phí theo từng ao, giao tận ao.', cta1: 'Xem sản phẩm', cta2: 'Nhận báo giá', sound: 'Bật nhạc', mute: 'Tắt nhạc',
      dTitle: 'Thiết kế bao bì mới', dLead: 'Nhãn và bao bì cho 15 sản phẩm: nền trắng, mỗi nhóm một màu riêng, logo TIM ở góc trái.', film: 'Phim giới thiệu', filmLead: 'Thủy Sản Tím trong 60 giây', play: 'Xem phim' },
    en: { eyebrow: 'Thuy San Tim', title: 'Refined bioscience,', em: 'assured harvests.', lead: 'Probiotics and nutrition for shrimp and fish ponds. Free technician advice for every pond, delivered to your pond.', cta1: 'View products', cta2: 'Get a quote', sound: 'Sound on', mute: 'Sound off',
      dTitle: 'New packaging design', dLead: 'Labels and packaging for 15 products: white base, one colour per group, TIM logo at top left.', film: 'Brand film', filmLead: 'Thuy San Tim in 60 seconds', play: 'Play film' },
    zh: { eyebrow: 'Thuy San Tim', title: '生物科技精粹，', em: '稳赢每一季。', lead: '虾、鱼塘益生菌与营养产品，技术员为每口池塘免费提供咨询，送货到塘。', cta1: '查看产品', cta2: '获取报价', sound: '开启音乐', mute: '关闭音乐',
      dTitle: '全新包装设计', dLead: '15款产品标签与包装：白色底，每组一种颜色，左上角TIM标志。', film: '品牌短片', filmLead: '60秒了解Thuy San Tim', play: '播放' },
  };
  const X = TXT[locale] || TXT.vi;
%>
<!-- ============ BRAND STAGE: sunset video, logo, music · packaging gallery · brand film ============ -->
<section class="stage" aria-label="<%= X.eyebrow %>">
  <div class="stage__media" aria-hidden="true">
    <%# Video nạp sau khi trang tải xong (stage.js) để không tranh băng thông với CSS/chữ; trước đó hiện ảnh poster %>
    <video class="stage__video" data-stage-video muted loop playsinline preload="none" poster="/video/hoang-hon-1280.webp" width="1280" height="720">
      <source data-src="/video/hoang-hon-720v.mp4" type="video/mp4" media="(max-width: 700px)">
      <source data-src="/video/hoang-hon-1280.mp4" type="video/mp4">
    </video>
  </div>
  <div class="container stage__inner">
    <div class="stage__copy">
      <p class="stage__eyebrow"><%= X.eyebrow %></p>
      <h1 class="stage__title"><%= X.title %> <em><%= X.em %></em></h1>
      <p class="stage__lead"><%= X.lead %></p>
      <div class="stage__cta">
        <a class="btn btn--primary btn--lg" href="<%= url('/products') %>"><%= X.cta1 %> <%- icon('arrow', '', 18) %></a>
        <a class="btn btn--ghost-light btn--lg" href="<%= url('/quote') %>"><%= X.cta2 %></a>
      </div>
    </div>
    <button class="stage__sound" type="button" data-stage-sound aria-pressed="false" data-on="<%= X.mute %>" data-off="<%= X.sound %>"><span class="stage__bars" aria-hidden="true"><i></i><i></i><i></i></span><span data-stage-sound-label><%= X.sound %></span></button>
  </div>
</section>

<section class="showcase-design" aria-label="<%= X.eyebrow %>">
  <div class="container">
    <div class="sd__grid">
      <div class="sd__head">
        <p class="eyebrow"><%= X.eyebrow %></p>
      </div>
      <figure class="sd__film">
        <video data-film controls preload="none" playsinline data-poster="/video/gioi-thieu-1280.webp" width="1280" height="720" aria-label="<%= X.film %>"><source src="/video/gioi-thieu-1280.mp4" type="video/mp4"></video>
        <figcaption><b><%= X.film %></b><span><%= X.filmLead %></span></figcaption>
      </figure>
    </div>
    <div class="sd__rail" data-rail tabindex="0" aria-label="<%= X.eyebrow %>">
      <% products.forEach(function (p) { if (!/^\/img\/products\//.test(p.imageSrc || '')) return; %>
      <a class="sd__item" href="<%= url('/products/' + p.slug) %>" style="--c: <%= p.color %>">
        <img src="<%= p.imageSrc %>" alt="<%= p.title %>" width="400" height="400" loading="lazy" decoding="async">
        <span><%= p.title.split('—')[0].trim() %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ STORE HERO: category list (joined to the menu bar) · slider ============ -->
<section class="shop-hero">
  <div class="container shop-hero__grid">
    <nav class="shop-cats" aria-label="<%= t('store.allCats') %>">
      <ul>
        <% categories.forEach(function (c) { %>
          <li><a href="<%= url('/products?category=' + c.slug) %>"><span class="catmenu__ic"><%- icon(c.icon, '', 18) %></span><span><%= c.title %></span><%- icon('chevron', '', 16) %></a></li>
        <% }) %>
        <li><a class="catmenu__all" href="<%= url('/products') %>"><span class="catmenu__ic"><%- icon('grid', '', 18) %></span><span><%= t('home.viewAll') %></span><%- icon('chevron', '', 16) %></a></li>
      </ul>
    </nav>

    <div class="slider" data-slider aria-roledescription="carousel" aria-label="<%= t('store.bestTitle') %>">
      <div class="slider__track">
        <% S.slides.forEach(function (s, i) { const p = bySlug[s.pid]; %>
          <div class="slide slide--<%= i + 1 %> <%= i === 0 ? 'is-active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> / <%= S.slides.length %>" <%= i ? 'aria-hidden="true"' : '' %> style="--c: <%= p ? p.color : 'var(--p-600)' %>">
            <div class="slide__copy">
              <span class="slide__tag"><%= s.tag %></span>
              <% if (i === 0) { %><h2 class="slide__title"><%= s.title %></h2><% } else { %><h2 class="slide__title"><%= s.title %></h2><% } %>
              <p class="slide__lead"><%= s.lead %></p>
              <a class="btn btn--accent" href="<%= url('/products?category=' + s.cat) %>" <%= i ? 'tabindex="-1"' : '' %>><%= s.cta %> <%- icon('arrow', '', 18) %></a>
            </div>
            <% if (p) { %><img class="slide__img" data-pack-fixed src="<%= p.image ? p.imageSrc : p.imageSrc + (p.imageSrc.includes('?') ? '&' : '?') + 'bg=0' %>" alt="<%= p.title %>" width="600" height="600" <%- i ? 'loading="lazy"' : 'fetchpriority="high"' %>><% } %>
          </div>
        <% }) %>
      </div>
      <button class="slider__nav slider__nav--prev" type="button" data-slide-prev aria-label="<%= t('store.prev') %>"><%- icon('chevronLeft', '', 22) %></button>
      <button class="slider__nav slider__nav--next" type="button" data-slide-next aria-label="<%= t('store.next') %>"><%- icon('chevron', '', 22) %></button>
      <div class="slider__dots">
        <% S.slides.forEach(function (s, i) { %><button type="button" data-slide-to="<%= i %>" class="<%= i === 0 ? 'is-active' : '' %>" aria-label="<%= i + 1 %>"></button><% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ============ POLICIES ============ -->
<section class="policy" aria-label="<%= t('home.featTitle') %>">
  <div class="container"><div class="policy__grid">
    <% L.home.promise.forEach(function (it) { %>
      <div class="policy__item">
        <span class="policy__icon"><%- icon(it.i, '', 24) %></span>
        <span><b><%= it.t %></b><small><%= it.d %></small></span>
      </div>
    <% }) %>
  </div></div>
</section>

<!-- ============ BEST SELLERS (row carousel) ============ -->
<section class="shop-block">
  <div class="container">
    <div class="shead">
      <h2 class="shead__title"><%- icon('sparkle', '', 20) %> <%= t('store.bestTitle') %></h2>
      <a class="shead__more" href="<%= url('/products') %>"><%= t('home.viewAll') %> <%- icon('chevron', '', 16) %></a>
    </div>
    <div class="prow" data-prow>
      <button class="prow__nav prow__nav--prev" type="button" data-prow-prev aria-label="<%= t('store.prev') %>"><%- icon('chevronLeft', '', 22) %></button>
      <div class="prow__track">
        <% featured.forEach(function (p) { %><%- include('../partials/product-card', { p }) %><% }) %>
      </div>
      <button class="prow__nav prow__nav--next" type="button" data-prow-next aria-label="<%= t('store.next') %>"><%- icon('chevron', '', 22) %></button>
    </div>
  </div>
</section>

<!-- ============ TWO BANNERS: services · handbook ============ -->
<section class="duo">
  <div class="container duo__grid">
    <div class="duo__card duo__card--svc">
      <div class="duo__menu">
        <b class="duo__title"><%- icon('headset', '', 22) %> <%= t('store.svcTitle') %></b>
        <ul>
          <li><a href="#consult"><%= S.side[0].t %></a></li>
          <li><a href="<%= url('/diseases') %>"><%= t('nav.diseases') %></a></li>
          <li><a href="<%= url('/quote') %>"><%= t('nav.quote') %></a></li>
          <li><a href="<%= url('/contact?kind=dealer') %>"><%= t('nav.dealer') %></a></li>
        </ul>
      </div>
      <a class="duo__media" href="#consult" tabindex="-1" aria-hidden="true">
        <% if (featured[0]) { %><img data-pack-fixed src="<%= featured[0].image ? featured[0].imageSrc : featured[0].imageSrc + (featured[0].imageSrc.includes('?') ? '&' : '?') + 'bg=0' %>" alt="" loading="lazy" width="600" height="600"><% } %>
        <span class="duo__cap"><b><%= S.side[0].t %></b><small><%= S.side[0].d %></small></span>
      </a>
    </div>
    <% if (guideMain) { const links = (guideChips.length ? guideChips : guideList).slice(0, 4); %>
    <div class="duo__card duo__card--news">
      <div class="duo__menu">
        <b class="duo__title"><%- icon('book', '', 22) %> <%= t('nav.blog') %></b>
        <ul>
          <% links.forEach(function (p) { %><li><a href="<%= url('/blog/' + p.slug) %>"><%= p.titleText.split(/[:—(]/)[0].trim() %></a></li><% }) %>
        </ul>
      </div>
      <a class="duo__media" href="<%= url('/blog/' + guideMain.slug) %>" tabindex="-1" aria-hidden="true">
        <img src="<%= guideMain.coverThumb %>"<% if (guideMain.coverThumbSet) { %> srcset="<%= guideMain.coverThumbSet %>" sizes="(min-width: 1100px) 560px, 92vw"<% } %> alt="" loading="lazy" decoding="async" width="1200" height="675">
      </a>
    </div>
    <% } %>
  </div>
</section>

<!-- ============ BY CATEGORY (tabs) ============ -->
<section class="shop-block" data-cat-tabs>
  <div class="container">
    <div class="shead">
      <h2 class="shead__title"><%- icon('grid', '', 20) %> <%= t('store.byCat') %></h2>
      <a class="shead__more" href="<%= url('/products') %>"><%= t('home.viewAll') %> <%- icon('chevron', '', 16) %></a>
    </div>
    <div class="shead__tabs" role="tablist" aria-label="<%= t('store.byCat') %>">
      <button type="button" role="tab" aria-selected="true" data-cat-tab=""><%= t('store.all') %></button>
      <% tabCats.forEach(function (c) { %><button type="button" role="tab" aria-selected="false" data-cat-tab="<%= c.slug %>"><%= c.title %></button><% }) %>
    </div>
    <div class="pgrid pgrid--5" data-cat-grid>
      <% products.forEach(function (p) { %><div class="pgrid__cell" data-cat="<%= p.category_slug %>"><%- include('../partials/product-card', { p }) %></div><% }) %>
    </div>
  </div>
</section>

<!-- ============ DISEASE BANNER ============ -->
<section class="section section--tight">
  <div class="container">
    <div class="dbanner">
      <div class="dbanner__copy">
        <span class="dbanner__icon"><%- icon('shield', '', 30) %></span>
        <div>
          <h2><%= t('store.diseaseTitle') %></h2>
          <p><%= t('store.diseaseLead') %></p>
        </div>
      </div>
      <div class="dbanner__chips">
        <% diseases.forEach(function (d) { %><a href="<%= url('/diseases/' + d.slug) %>"><%= d.title.split(/[(—:]/)[0].trim() %></a><% }) %>
      </div>
      <div class="dbanner__cta">
        <a class="btn btn--accent" href="<%= url('/diseases') %>"><%- icon('search', '', 18) %> <%= t('store.diseaseCta') %></a>
        <a class="btn btn--glass" href="<%= zaloHref %>" target="_blank" rel="noopener"><%- icon('zalo', '', 18) %> <%= t('store.diseaseZalo') %></a>
      </div>
    </div>
  </div>
</section>

<!-- ============ NEWS (3 columns) ============ -->
<% if (guideMain) { %>
<section class="shop-block news">
  <div class="container">
    <div class="shead">
      <h2 class="shead__title"><%- icon('book', '', 20) %> <%= t('store.newsTitle') %></h2>
      <a class="shead__more" href="<%= url('/blog') %>"><%= t('blog.backToBlog') %> <%- icon('chevron', '', 16) %></a>
    </div>
    <div class="news__grid">
      <% [guideMain].concat(guideList).slice(0, 3).forEach(function (p) { %>
        <article class="ncard">
          <a class="ncard__cover" href="<%= url('/blog/' + p.slug) %>" tabindex="-1" aria-hidden="true"><img src="<%= p.coverThumb %>"<% if (p.coverThumbSet) { %> srcset="<%= p.coverThumbSet %>" sizes="(min-width: 1100px) 380px, (min-width: 700px) 45vw, 92vw"<% } %> alt="" loading="lazy" decoding="async" width="1200" height="675"></a>
          <h3 class="ncard__title"><a href="<%= url('/blog/' + p.slug) %>"><%= p.titleText %></a></h3>
          <p class="ncard__excerpt"><%= p.excerptText %></p>
          <span class="ncard__meta"><%- icon('clock', '', 14) %> <%= p.read_minutes %> <%= t('blog.minutes') %></span>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ FAQ ============ -->
<section class="section section--tint home-faq">
  <div class="container home-faq__grid">
    <div class="reveal">
      <span class="eyebrow"><%= t('home.faqEyebrow') %></span>
      <h2 class="section__title"><%= t('home.faqTitle') %></h2>
      <p class="section__lead"><%= t('blog.expertText') %></p>
      <a class="btn btn--primary" href="<%= url('/contact') %>" style="margin-top:24px"><%= t('hero.cta2') %> <%- icon('arrow', '', 18) %></a>
    </div>
    <div class="faq faq--home">
      <% L.home.faq.forEach(function (f, i) { %>
        <details class="faq__item reveal" <%= i === 0 ? 'open' : '' %>>
          <summary><span><%= f.q %></span><i aria-hidden="true"></i></summary>
          <div class="faq__a"><p><%= f.a %></p></div>
        </details>
      <% }) %>
    </div>
  </div>
  <script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: L.home.faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; })
  }).replace(/</g, '\\u003c') %></script>
</section>

<!-- ============ CTA ============ -->
<section class="cta" id="consult">
  <div class="container">
    <div class="cta__box reveal">
      <canvas class="aquarium" data-aquarium="light" aria-hidden="true"></canvas>
      <div class="cta__copy">
        <h2><%= t('home.ctaTitle') %></h2>
        <p><%= t('home.ctaLead') %></p>
        <a class="cta__phone" href="tel:<%= (company.hotline || '').replace(/\s/g, '') %>"><%- icon('phone', '', 22) %> <%= company.hotline %></a>
      </div>
      <form class="cta__form" action="<%= url('/inquiry') %>" method="post" data-ajax-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="kind" value="callback">
        <input type="hidden" name="back" value="<%= url('') %>">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="field field--dark"><label for="cta-name"><%= t('form.name') %> *</label><input id="cta-name" name="name" required autocomplete="name"></div>
        <div class="field field--dark"><label for="cta-phone"><%= t('form.phone') %> *</label><input id="cta-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel"></div>
        <div class="field field--dark field--full"><label for="cta-msg"><%= t('form.message') %> <small>(<%= t('form.optional') %>)</small></label><input id="cta-msg" name="message"></div>
        <button class="btn btn--accent btn--lg btn--block" type="submit"><%= t('home.ctaBtn') %> <%- icon('arrow', '', 18) %></button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
