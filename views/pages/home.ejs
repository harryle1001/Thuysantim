<%- include('../partials/head') %>
<% const company = settings.company || {}; const stats = settings.stats || {}; %>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__grid"></div>
    <canvas class="aquarium" data-aquarium></canvas>
    <svg class="hero__molecules" viewBox="0 0 600 600">
      <g stroke="rgba(196,181,253,.35)" stroke-width="1.2" fill="none">
        <path d="M80 140 L160 100 L240 150 L230 240 L150 270 L90 220 Z"/>
        <path d="M240 150 L320 110 M230 240 L310 280 L390 240"/>
        <path d="M420 420 L480 380 L540 420 L540 490 L480 530 L420 490 Z"/>
      </g>
      <g fill="#c4b5fd">
        <circle cx="80" cy="140" r="4"/><circle cx="160" cy="100" r="5"/><circle cx="240" cy="150" r="4"/><circle cx="230" cy="240" r="6"/><circle cx="150" cy="270" r="4"/><circle cx="90" cy="220" r="3"/><circle cx="320" cy="110" r="3"/><circle cx="310" cy="280" r="4"/><circle cx="390" cy="240" r="3"/>
        <circle cx="420" cy="420" r="4"/><circle cx="480" cy="380" r="3"/><circle cx="540" cy="420" r="5"/><circle cx="540" cy="490" r="3"/><circle cx="480" cy="530" r="4"/><circle cx="420" cy="490" r="3"/>
      </g>
    </svg>
    <svg class="hero__waves" viewBox="0 0 1440 260" preserveAspectRatio="none">
      <path class="wave wave--1" d="M0 140 C 240 80 480 200 720 140 S 1200 80 1440 140 V260 H0z"/>
      <path class="wave wave--2" d="M0 180 C 280 130 520 230 760 180 S 1180 120 1440 170 V260 H0z"/>
      <path class="wave wave--3" d="M0 215 C 300 185 560 245 820 215 S 1220 185 1440 210 V260 H0z"/>
    </svg>
    <div class="bubbles"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow eyebrow--light reveal"><%- icon('dna', '', 16) %> <%= t('hero.eyebrow') %></span>
      <h1 class="hero__title reveal"><%- t('hero.title') %></h1>
      <p class="hero__lead reveal"><%= t('hero.lead') %></p>
      <div class="hero__ctas reveal">
        <a class="btn btn--accent btn--lg" href="<%= url('/products') %>"><%= t('hero.cta1') %> <%- icon('arrow', '', 18) %></a>
        <a class="btn btn--glass btn--lg" href="#consult"><%- icon('headset', '', 18) %> <%= t('hero.cta2') %></a>
      </div>
      <div class="hero__trust reveal">
        <div class="avatars" aria-hidden="true"><span>H</span><span>M</span><span>T</span><span>+</span></div>
        <div>
          <div class="stars" aria-label="4.9/5"><%- icon('star', '', 14) %><%- icon('star', '', 14) %><%- icon('star', '', 14) %><%- icon('star', '', 14) %><%- icon('star', '', 14) %> <b>4.9</b></div>
          <small><%= t('hero.trust') %></small>
        </div>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__ring"></div>
      <% const heroProducts = featured.slice(0, 3); %>
      <% heroProducts.forEach(function (p, i) { %>
        <img class="hero__pack hero__pack--<%= i + 1 %>" src="<%= p.image ? p.imageSrc : p.imageSrc + '?bg=0' %>" alt="" width="600" height="600">
      <% }) %>
      <div class="glass-card glass-card--1"><span class="glass-card__icon"><%- icon('microbe', '', 20) %></span><div><b>10<sup>10</sup> CFU/g</b><small><%= t('hero.card1') %></small></div></div>
      <div class="glass-card glass-card--2"><span class="glass-card__icon glass-card__icon--aqua"><%- icon('shield', '', 20) %></span><div><b>0%</b><small><%= t('hero.card2') %></small></div></div>
      <div class="glass-card glass-card--3"><span class="glass-card__icon glass-card__icon--gold"><%- icon('headset', '', 20) %></span><div><b>24/7</b><small><%= t('hero.card3') %></small></div></div>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="stats">
  <div class="container stats__grid">
    <% [['years', stats.years, '+'], ['dealers', stats.dealers, '+'], ['provinces', stats.provinces, ''], ['ponds', stats.ponds, '+']].forEach(function (s) { %>
      <div class="stat reveal">
        <div class="stat__num"><span data-count="<%= s[1] || 0 %>">0</span><%= s[2] %></div>
        <div class="stat__label"><%= t('stats.' + s[0]) %></div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ============ MARQUEE ============ -->
<section class="marquee" aria-label="<%= t('footer.about') %>">
  <div class="marquee__track">
    <% for (let g = 0; g < 2; g++) { %>
      <div class="marquee__group" <%= g ? 'aria-hidden="true"' : '' %>>
        <% L.home.marquee.forEach(function (m) { %>
          <span class="marquee__item"><%= m %></span>
          <img class="marquee__sep" src="/img/emblem-mark.svg" alt="" width="30" height="30">
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- ============ CATEGORIES ============ -->
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow"><%= t('nav.products') %></span>
      <h2 class="section__title"><%= t('home.catTitle') %></h2>
      <p class="section__lead"><%= t('home.catLead') %></p>
    </div>
    <div class="cats">
      <% categories.forEach(function (c, i) { %>
        <a class="cat reveal" href="<%= url('/products?category=' + c.slug) %>" style="--d: <%= i * 60 %>ms">
          <span class="cat__icon"><%- icon(c.icon, '', 26) %></span>
          <span class="cat__title"><%= c.title %></span>
          <span class="cat__desc"><%= c.desc %></span>
          <span class="cat__foot"><%= c.product_count %> <%= t('product.results') %> <%- icon('arrow', '', 16) %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ FEATURED ============ -->
<section class="section section--tint">
  <div class="container">
    <div class="section__head section__head--split reveal">
      <div>
        <span class="eyebrow"><%- icon('sparkle', '', 14) %> <%= t('home.featTitle') %></span>
        <h2 class="section__title"><%= t('home.featTitle') %></h2>
        <p class="section__lead"><%= t('home.featLead') %></p>
      </div>
      <a class="btn btn--outline" href="<%= url('/products') %>"><%= t('home.viewAll') %> <%- icon('arrow', '', 18) %></a>
    </div>
    <div class="pgrid">
      <% featured.slice(0, 8).forEach(function (p) { %><%- include('../partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<!-- ============ STAGES ============ -->
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow"><%= t('home.stageTitle') %></span>
      <h2 class="section__title"><%= t('home.stageTitle') %></h2>
      <p class="section__lead"><%= t('home.stageLead') %></p>
    </div>
    <ol class="stages">
      <% L.home.stages.forEach(function (s, i) { %>
        <li class="stage reveal" style="--d: <%= i * 90 %>ms">
          <span class="stage__k"><%= s.k %></span>
          <h3 class="stage__t"><%= s.t %></h3>
          <p class="stage__d"><%= s.d %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<!-- ============ SCIENCE ============ -->
<section class="science">
  <div class="container science__inner">
    <div class="science__visual reveal" aria-hidden="true">
      <svg viewBox="0 0 520 520" class="petri">
        <defs>
          <radialGradient id="pd" cx="50%" cy="45%" r="55%"><stop offset="0" stop-color="#3b1a78"/><stop offset="1" stop-color="#150a2e"/></radialGradient>
          <radialGradient id="glow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#5eead4" stop-opacity=".9"/><stop offset="1" stop-color="#5eead4" stop-opacity="0"/></radialGradient>
        </defs>
        <circle cx="260" cy="260" r="230" fill="url(#pd)" stroke="rgba(196,181,253,.35)" stroke-width="2"/>
        <circle cx="260" cy="260" r="205" fill="none" stroke="rgba(196,181,253,.15)" stroke-width="10"/>
        <g class="colonies">
          <circle cx="190" cy="200" r="34" fill="url(#glow)" opacity=".55"/>
          <circle cx="320" cy="180" r="22" fill="url(#glow)" opacity=".45"/>
          <circle cx="300" cy="320" r="44" fill="url(#glow)" opacity=".5"/>
          <circle cx="180" cy="330" r="18" fill="url(#glow)" opacity=".4"/>
          <circle cx="360" cy="260" r="14" fill="url(#glow)" opacity=".5"/>
        </g>
        <g fill="#c4b5fd" opacity=".85">
          <rect x="182" y="194" width="16" height="6" rx="3" transform="rotate(30 190 197)"/>
          <rect x="296" y="312" width="18" height="6" rx="3" transform="rotate(-20 305 315)"/>
          <rect x="312" y="176" width="14" height="5" rx="2.5" transform="rotate(60 319 178)"/>
          <rect x="174" y="326" width="12" height="5" rx="2.5"/>
          <rect x="285" y="330" width="14" height="5" rx="2.5" transform="rotate(45 292 332)"/>
          <rect x="200" y="210" width="12" height="5" rx="2.5" transform="rotate(-40 206 212)"/>
        </g>
        <circle cx="260" cy="260" r="248" fill="none" stroke="rgba(94,234,212,.4)" stroke-dasharray="2 10" class="petri__orbit"/>
      </svg>
      <div class="science__chip science__chip--1"><%- icon('lab', '', 18) %> ISO 17025</div>
      <div class="science__chip science__chip--2"><%- icon('badge', '', 18) %> GMP</div>
    </div>
    <div class="science__copy">
      <span class="eyebrow eyebrow--light reveal"><%= t('home.scienceEyebrow') %></span>
      <h2 class="section__title section__title--light reveal"><%= t('home.scienceTitle') %></h2>
      <p class="science__lead reveal"><%= t('home.scienceLead') %></p>
      <ul class="science__list">
        <% L.home.science.forEach(function (s, i) { %>
          <li class="reveal">
            <span class="science__icon"><%- icon(['dna', 'lab', 'barcode'][i], '', 22) %></span>
            <div><h3><%= s.t %></h3><p><%= s.d %></p></div>
          </li>
        <% }) %>
      </ul>
      <a class="btn btn--glass reveal" href="<%= url('/about') %>"><%= t('home.labCta') %> <%- icon('arrow', '', 18) %></a>
    </div>
  </div>
</section>

<!-- ============ DISEASES ============ -->
<section class="section">
  <div class="container">
    <div class="section__head section__head--split reveal">
      <div>
        <span class="eyebrow"><%- icon('alert', '', 14) %> <%= t('nav.diseases') %></span>
        <h2 class="section__title"><%= t('home.diseaseTitle') %></h2>
        <p class="section__lead"><%= t('home.diseaseLead') %></p>
      </div>
      <a class="btn btn--outline" href="<%= url('/diseases') %>"><%= t('nav.diseases') %> <%- icon('arrow', '', 18) %></a>
    </div>
    <div class="dgrid">
      <% diseases.forEach(function (d) { %>
        <a class="dcard dcard--<%= d.severity %> reveal" href="<%= url('/diseases/' + d.slug) %>">
          <span class="dcard__top">
            <span class="sev sev--<%= d.severity %>"><%= t('disease.severity.' + d.severity) %></span>
            <span class="dcard__species"><%- icon(d.species === 'fish' ? 'fish' : 'shrimp', '', 16) %> <%= t('disease.species.' + d.species) %></span>
          </span>
          <h3 class="dcard__title"><%= d.title %></h3>
          <p class="dcard__text"><%= d.symptomsText %></p>
          <span class="link-arrow"><%= t('disease.readMore') %> <%- icon('arrow', '', 16) %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section section--tint">
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow"><%- icon('star', '', 14) %> 4.9/5</span>
      <h2 class="section__title"><%= t('home.testiTitle') %></h2>
    </div>
    <div class="testis">
      <% L.home.testimonials.forEach(function (q, i) { %>
        <figure class="testi reveal" style="--d: <%= i * 80 %>ms">
          <div class="stars"><%- icon('star', '', 16) %><%- icon('star', '', 16) %><%- icon('star', '', 16) %><%- icon('star', '', 16) %><%- icon('star', '', 16) %></div>
          <blockquote>“<%= q.q %>”</blockquote>
          <figcaption><span class="testi__avatar"><%= q.n.split(' ').pop().charAt(0) %></span><span><b><%= q.n %></b><small><%= q.r %></small></span></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ BLOG ============ -->
<section class="section">
  <div class="container">
    <div class="section__head section__head--split reveal">
      <div>
        <span class="eyebrow"><%- icon('book', '', 14) %> <%= t('nav.blog') %></span>
        <h2 class="section__title"><%= t('home.blogTitle') %></h2>
        <p class="section__lead"><%= t('home.blogLead') %></p>
      </div>
      <a class="btn btn--outline" href="<%= url('/blog') %>"><%= t('nav.blog') %> <%- icon('arrow', '', 18) %></a>
    </div>
    <div class="bgrid">
      <% posts.forEach(function (p) { %><%- include('../partials/post-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="cta" id="consult">
  <div class="container">
    <div class="cta__box reveal">
      <canvas class="aquarium" data-aquarium="light" aria-hidden="true"></canvas>
      <div class="cta__copy">
        <h2><%= t('home.ctaTitle') %></h2>
        <p><%= t('home.ctaLead') %></p>
        <a class="cta__phone" href="tel:<%= (company.hotline || '').replace(/\s/g, '') %>"><%- icon('phone', '', 22) %> <%= company.hotline %></a>
      </div>
      <form class="cta__form" action="<%= url('/inquiry') %>" method="post" data-ajax-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="kind" value="callback">
        <input type="hidden" name="back" value="<%= url('') %>">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="field field--dark"><label for="cta-name"><%= t('form.name') %> *</label><input id="cta-name" name="name" required autocomplete="name"></div>
        <div class="field field--dark"><label for="cta-phone"><%= t('form.phone') %> *</label><input id="cta-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel"></div>
        <div class="field field--dark field--full"><label for="cta-msg"><%= t('form.message') %> <small>(<%= t('form.optional') %>)</small></label><input id="cta-msg" name="message"></div>
        <button class="btn btn--accent btn--lg btn--block" type="submit"><%= t('home.ctaBtn') %> <%- icon('arrow', '', 18) %></button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
