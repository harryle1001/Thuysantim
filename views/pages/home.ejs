<%- include('../partials/head') %>
<%
  const company = settings.company || {};
  const S = L.store;
  const bySlug = {};
  products.forEach(function (p) { bySlug[p.slug] = p; });
  const tabCats = categories.filter(function (c) { return c.product_count > 0; });
  const zaloHref = company.zalo ? 'https://zalo.me/' + company.zalo : url('/contact');
%>

<!-- ============ STORE HERO: categories · slider · side banners ============ -->
<section class="shop-hero">
  <div class="container shop-hero__grid">
    <nav class="shop-cats" aria-label="<%= t('store.allCats') %>">
      <ul>
        <% categories.forEach(function (c) { %>
          <li><a href="<%= url('/products?category=' + c.slug) %>"><span class="catmenu__ic"><%- icon(c.icon, '', 18) %></span><span><%= c.title %></span><%- icon('chevron', '', 16) %></a></li>
        <% }) %>
        <li><a class="catmenu__all" href="<%= url('/products') %>"><span class="catmenu__ic"><%- icon('grid', '', 18) %></span><span><%= t('home.viewAll') %></span><%- icon('chevron', '', 16) %></a></li>
      </ul>
    </nav>

    <div class="slider" data-slider aria-roledescription="carousel" aria-label="<%= t('store.bestTitle') %>">
      <div class="slider__track">
        <% S.slides.forEach(function (s, i) { const p = bySlug[s.pid]; %>
          <div class="slide slide--<%= i + 1 %> <%= i === 0 ? 'is-active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> / <%= S.slides.length %>" <%= i ? 'aria-hidden="true"' : '' %> style="--c: <%= p ? p.color : 'var(--p-600)' %>">
            <div class="slide__copy">
              <span class="slide__tag"><%= s.tag %></span>
              <% if (i === 0) { %><h1 class="slide__title"><%= s.title %></h1><% } else { %><h2 class="slide__title"><%= s.title %></h2><% } %>
              <p class="slide__lead"><%= s.lead %></p>
              <a class="btn btn--accent" href="<%= url('/products?category=' + s.cat) %>" <%= i ? 'tabindex="-1"' : '' %>><%= s.cta %> <%- icon('arrow', '', 18) %></a>
            </div>
            <% if (p) { %><img class="slide__img" data-pack-fixed src="<%= p.image ? p.imageSrc : p.imageSrc + '?bg=0' %>" alt="<%= p.title %>" width="600" height="600" <%= i ? 'loading="lazy"' : 'fetchpriority="high"' %>><% } %>
          </div>
        <% }) %>
      </div>
      <button class="slider__nav slider__nav--prev" type="button" data-slide-prev aria-label="<%= t('store.prev') %>"><%- icon('chevronLeft', '', 22) %></button>
      <button class="slider__nav slider__nav--next" type="button" data-slide-next aria-label="<%= t('store.next') %>"><%- icon('chevron', '', 22) %></button>
      <div class="slider__dots">
        <% S.slides.forEach(function (s, i) { %><button type="button" data-slide-to="<%= i %>" class="<%= i === 0 ? 'is-active' : '' %>" aria-label="<%= i + 1 %>"></button><% }) %>
      </div>
    </div>

    <div class="shop-side">
      <% S.side.forEach(function (b, i) { %>
        <a class="shop-side__card shop-side__card--<%= i + 1 %>" href="<%= b.href.charAt(0) === '#' ? b.href : url(b.href) %>">
          <span class="shop-side__icon"><%- icon(b.i, '', 26) %></span>
          <b><%= b.t %></b>
          <small><%= b.d %></small>
          <span class="link-arrow"><%- icon('arrow', '', 16) %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ POLICIES ============ -->
<section class="policy" aria-label="<%= t('home.featTitle') %>">
  <div class="container"><div class="policy__grid">
    <% L.home.promise.forEach(function (it) { %>
      <div class="policy__item">
        <span class="policy__icon"><%- icon(it.i, '', 24) %></span>
        <span><b><%= it.t %></b><small><%= it.d %></small></span>
      </div>
    <% }) %>
  </div></div>
</section>

<!-- ============ BEST SELLERS ============ -->
<section class="section shop-block">
  <div class="container">
    <div class="shead">
      <h2 class="shead__title"><%- icon('sparkle', '', 20) %> <%= t('store.bestTitle') %></h2>
      <a class="shead__more" href="<%= url('/products') %>"><%= t('home.viewAll') %> <%- icon('chevron', '', 16) %></a>
    </div>
    <div class="pgrid pgrid--5">
      <% featured.slice(0, featured.length >= 10 ? 10 : 5).forEach(function (p) { %><%- include('../partials/product-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<!-- ============ BY CATEGORY (tabs) ============ -->
<section class="section shop-block shop-block--tint" data-cat-tabs>
  <div class="container">
    <div class="shead shead--tabs">
      <h2 class="shead__title"><%- icon('grid', '', 20) %> <%= t('store.byCat') %></h2>
      <div class="shead__tabs" role="tablist" aria-label="<%= t('store.byCat') %>">
        <button type="button" role="tab" aria-selected="true" data-cat-tab=""><%= t('store.all') %></button>
        <% tabCats.forEach(function (c) { %><button type="button" role="tab" aria-selected="false" data-cat-tab="<%= c.slug %>"><%= c.title %></button><% }) %>
      </div>
    </div>
    <div class="pgrid pgrid--5" data-cat-grid>
      <% products.forEach(function (p) { %><div class="pgrid__cell" data-cat="<%= p.category_slug %>"><%- include('../partials/product-card', { p }) %></div><% }) %>
    </div>
  </div>
</section>

<!-- ============ DISEASE BANNER ============ -->
<section class="section section--tight">
  <div class="container">
    <div class="dbanner">
      <div class="dbanner__copy">
        <span class="dbanner__icon"><%- icon('shield', '', 30) %></span>
        <div>
          <h2><%= t('store.diseaseTitle') %></h2>
          <p><%= t('store.diseaseLead') %></p>
        </div>
      </div>
      <div class="dbanner__chips">
        <% diseases.forEach(function (d) { %><a href="<%= url('/diseases/' + d.slug) %>"><%= d.title.split(/[(—:]/)[0].trim() %></a><% }) %>
      </div>
      <div class="dbanner__cta">
        <a class="btn btn--accent" href="<%= url('/diseases') %>"><%- icon('search', '', 18) %> <%= t('store.diseaseCta') %></a>
        <a class="btn btn--glass" href="<%= zaloHref %>" target="_blank" rel="noopener"><%- icon('zalo', '', 18) %> <%= t('store.diseaseZalo') %></a>
      </div>
    </div>
  </div>
</section>

<!-- ============ HANDBOOK ============ -->
<% if (guideMain) { %>
<section class="section shop-block guide">
  <div class="container">
    <div class="shead">
      <h2 class="shead__title"><%- icon('book', '', 20) %> <%= t('store.newsTitle') %></h2>
      <a class="shead__more" href="<%= url('/blog') %>"><%= t('blog.backToBlog') %> <%- icon('chevron', '', 16) %></a>
    </div>
    <div class="guide__grid">
      <a class="guide__main reveal" href="<%= url('/blog/' + guideMain.slug) %>">
        <span class="guide__cover"><img src="<%= guideMain.coverSrc %>" alt="<%= guideMain.titleText %>" loading="lazy" width="1200" height="675"></span>
        <span class="guide__body">
          <span class="pill pill--new"><%= t('blog.featured') %></span>
          <h3 class="guide__title"><%= guideMain.titleText %></h3>
          <p class="guide__excerpt"><%= guideMain.excerptText %></p>
          <span class="guide__meta"><%- icon('clock', '', 15) %> <%= guideMain.read_minutes %> <%= t('blog.minutes') %> <span class="link-arrow"><%= t('blog.readMore') %> <%- icon('arrow', '', 16) %></span></span>
        </span>
      </a>
      <ol class="guide__list">
        <% guideList.forEach(function (p, i) { %>
          <li class="reveal" style="--d: <%= i * 70 %>ms">
            <a href="<%= url('/blog/' + p.slug) %>">
              <span class="guide__num"><%= String(i + 2).padStart(2, '0') %></span>
              <span>
                <small><%= t('blog.topics.' + p.topic) %> · <%= p.read_minutes %> <%= t('blog.minutes') %></small>
                <b><%= p.titleText %></b>
              </span>
            </a>
          </li>
        <% }) %>
      </ol>
    </div>
    <% if (guideChips.length) { %>
    <div class="guide__chips reveal">
      <span><%- icon('search', '', 16) %> <%= t('home.guideTopics') %>:</span>
      <% guideChips.forEach(function (p) { %><a href="<%= url('/blog/' + p.slug) %>"><%= p.titleText.split(/[:,—(]/)[0].trim() %></a><% }) %>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- ============ FAQ ============ -->
<section class="section section--tint home-faq">
  <div class="container home-faq__grid">
    <div class="reveal">
      <span class="eyebrow"><%= t('home.faqEyebrow') %></span>
      <h2 class="section__title"><%= t('home.faqTitle') %></h2>
      <p class="section__lead"><%= t('blog.expertText') %></p>
      <a class="btn btn--primary" href="<%= url('/contact') %>" style="margin-top:24px"><%= t('hero.cta2') %> <%- icon('arrow', '', 18) %></a>
    </div>
    <div class="faq faq--home">
      <% L.home.faq.forEach(function (f, i) { %>
        <details class="faq__item reveal" <%= i === 0 ? 'open' : '' %>>
          <summary><span><%= f.q %></span><i aria-hidden="true"></i></summary>
          <div class="faq__a"><p><%= f.a %></p></div>
        </details>
      <% }) %>
    </div>
  </div>
  <script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: L.home.faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; })
  }).replace(/</g, '\\u003c') %></script>
</section>

<!-- ============ CTA ============ -->
<section class="cta" id="consult">
  <div class="container">
    <div class="cta__box reveal">
      <canvas class="aquarium" data-aquarium="light" aria-hidden="true"></canvas>
      <div class="cta__copy">
        <h2><%= t('home.ctaTitle') %></h2>
        <p><%= t('home.ctaLead') %></p>
        <a class="cta__phone" href="tel:<%= (company.hotline || '').replace(/\s/g, '') %>"><%- icon('phone', '', 22) %> <%= company.hotline %></a>
      </div>
      <form class="cta__form" action="<%= url('/inquiry') %>" method="post" data-ajax-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="kind" value="callback">
        <input type="hidden" name="back" value="<%= url('') %>">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="field field--dark"><label for="cta-name"><%= t('form.name') %> *</label><input id="cta-name" name="name" required autocomplete="name"></div>
        <div class="field field--dark"><label for="cta-phone"><%= t('form.phone') %> *</label><input id="cta-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel"></div>
        <div class="field field--dark field--full"><label for="cta-msg"><%= t('form.message') %> <small>(<%= t('form.optional') %>)</small></label><input id="cta-msg" name="message"></div>
        <button class="btn btn--accent btn--lg btn--block" type="submit"><%= t('home.ctaBtn') %> <%- icon('arrow', '', 18) %></button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
