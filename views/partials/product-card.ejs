<article class="pcard reveal" style="--c: <%= p.color %>">
  <a class="pcard__media" href="<%= url('/products/' + p.slug) %>" tabindex="-1" aria-hidden="true">
    <img src="<%= p.imageSrc %>" alt="<%= p.title %>" loading="lazy" decoding="async" width="600" height="600">
    <% if (p.badge) { %><span class="pill pill--<%= p.badge %>"><%= t('product.badges.' + p.badge) %></span><% } %>
  </a>
  <div class="pcard__body">
    <div class="pcard__meta">
      <span><%= p.categoryTitle %></span>
      <span class="pcard__species"><%- icon(p.species === 'fish' ? 'fish' : 'shrimp', '', 14) %> <%= t('disease.species.' + p.species) %></span>
    </div>
    <h3 class="pcard__title"><a href="<%= url('/products/' + p.slug) %>"><%= p.title %></a></h3>
    <p class="pcard__summary"><%= p.summaryText %></p>
    <div class="pcard__foot">
      <div class="pcard__price">
        <% if (p.minPrice) { %><small><%= t('product.from') %></small> <strong><%= money(p.minPrice) %></strong><% } else { %><strong><%= t('product.requestQuote') %></strong><% } %>
      </div>
      <% if (p.minPrice) { %>
        <button class="pcard__add" type="button" data-add-to-cart data-pid="<%= p.id %>" data-vi="0" aria-label="<%= t('product.addToCart') %>: <%= p.title %>"><%- icon('plus', '', 18) %></button>
      <% } %>
    </div>
  </div>
</article>
