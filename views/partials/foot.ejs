<% const company = (settings && settings.company) || {}; %>
</main>

<footer class="footer">
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="brand brand--light" href="<%= url('') %>">
          <%- include('logo', { uid: 'f' }) %>
          <span class="brand__text"><span class="brand__name">THỦY SẢN <b>TÍM</b></span><span class="brand__tag"><%= tr(company.tagline) %></span></span>
        </a>
        <p class="footer__about"><%= t('footer.about') %></p>
        <div class="socials">
          <% if (company.facebook) { %><a href="<%= company.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><%- icon('facebook', '', 18) %></a><% } %>
          <% if (company.youtube) { %><a href="<%= company.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><%- icon('youtube', '', 18) %></a><% } %>
          <% if (company.tiktok) { %><a href="<%= company.tiktok %>" target="_blank" rel="noopener" aria-label="TikTok"><%- icon('tiktok', '', 18) %></a><% } %>
          <% if (company.zalo) { %><a href="https://zalo.me/<%= company.zalo %>" target="_blank" rel="noopener" aria-label="Zalo"><%- icon('zalo', '', 18) %></a><% } %>
        </div>
      </div>

      <div class="footer__col">
        <h3><%= t('footer.links') %></h3>
        <ul>
          <li><a href="<%= url('/products') %>"><%= t('nav.products') %></a></li>
          <li><a href="<%= url('/diseases') %>"><%= t('nav.diseases') %></a></li>
          <li><a href="<%= url('/blog') %>"><%= t('nav.blog') %></a></li>
          <li><a href="<%= url('/about') %>"><%= t('nav.about') %></a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h3><%= t('footer.support') %></h3>
        <ul>
          <li><a href="<%= url('/quote') %>"><%= t('nav.quote') %></a></li>
          <li><a href="<%= url('/order-lookup') %>"><%= t('nav.lookup') %></a></li>
          <li><a href="<%= url('/contact?kind=dealer') %>"><%= t('nav.dealer') %></a></li>
          <li><a href="<%= url('/contact') %>"><%= t('nav.contact') %></a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h3><%= t('footer.policies') %></h3>
        <ul>
          <% (typeof policyLinks !== 'undefined' ? policyLinks : []).forEach(function (p) { %>
          <li><a href="<%= url('/policies/' + p.slug) %>"><%= p.title %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="footer__col footer__contact">
        <h3><%= t('nav.contact') %></h3>
        <ul>
          <li><%- icon('pin', '', 18) %><span><%= tr(company.address) %></span></li>
          <li><%- icon('phone', '', 18) %><a href="tel:<%= (company.hotline || '').replace(/\s/g, '') %>"><%= company.hotline %></a> · <a href="tel:<%= (company.phone || '').replace(/\s/g, '') %>"><%= company.phone %></a></li>
          <li><%- icon('mail', '', 18) %><a href="mailto:<%= company.email %>"><%= company.email %></a></li>
          <li><%- icon('clock', '', 18) %><span><%= tr(company.hours) %></span></li>
        </ul>
        <form class="newsletter" action="<%= url('/inquiry') %>" method="post" data-ajax-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="kind" value="newsletter">
          <input type="hidden" name="back" value="<%= url(pathRest) %>">
          <label class="sr-only" for="nl-email"><%= t('form.email') %></label>
          <input id="nl-email" type="email" name="email" required placeholder="<%= t('footer.newsletter') %>…">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn--accent btn--sm" type="submit"><%= t('footer.subscribe') %></button>
        </form>
      </div>
    </div>

    <div class="footer__legal">
      <div class="footer__legaltext">
        <b><%= tr(company.legal) || 'Công ty TNHH Thủy Sản Tím' %></b>
        <span><%= t('footer.taxCode') %>: <%= legalInfo.taxCode %><% if (legalInfo.licenseDate) { %> · <%= t('footer.issued') %> <%= legalInfo.licenseDate %><% } %><% if (legalInfo.licenseIssuer) { %> · <%= t('footer.at') %> <%= legalInfo.licenseIssuer %><% } %></span>
        <% if (legalInfo.representative) { %><span><%= locale === 'vi' ? 'Người đại diện' : locale === 'zh' ? '法定代表人' : 'Legal representative' %>: <%= legalInfo.representative %></span><% } %>
      </div>
      <% if (company.bctUrl) { %><a class="footer__bct" href="<%= company.bctUrl %>" target="_blank" rel="noopener" title="<%= t('footer.notified') %>"><img src="https://online.gov.vn/Content/EndUser/LogoCCDVSaleNoti/logoSaleNoti.png" alt="<%= t('footer.notified') %>" width="150" height="57" loading="lazy"></a><% } %>
    </div>

    <div class="footer__bottom">
      <span>© <%= new Date().getFullYear() %> <%= tr(company.legal) || 'Thủy Sản Tím' %>. <%= t('footer.rights') %></span>
      <span class="footer__sample"><%= t('footer.sample') %></span>
    </div>
  </div>
</footer>

<div class="fab" aria-label="Quick contact" data-fab>
  <% if (company.messenger) { %><a class="fab__btn fab__btn--messenger" href="https://m.me/<%= company.messenger %>" target="_blank" rel="noopener" aria-label="<%= t('common.chatMessenger') %>" data-tip="<%= t('common.chatMessenger') %>">
    <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path fill="#fff" d="M14 3C7.9 3 3 7.6 3 13.3c0 3.2 1.6 6.1 4.1 8v3.9l3.7-2c1 .3 2.1.4 3.2.4 6.1 0 11-4.6 11-10.3S20.1 3 14 3z"/><path fill="url(#fabMsg)" d="m7.6 16.5 3.4-5.4c.5-.9 1.7-1.1 2.5-.5l2.7 2c.2.2.6.2.8 0l3.6-2.8c.5-.4 1.1.2.8.7l-3.4 5.4c-.5.9-1.7 1.1-2.5.5l-2.7-2a.6.6 0 0 0-.8 0l-3.6 2.8c-.5.4-1.1-.2-.8-.7z"/><defs><linearGradient id="fabMsg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0a7cff"/><stop offset=".6" stop-color="#a033ff"/><stop offset="1" stop-color="#ff5c87"/></linearGradient></defs></svg>
  </a><% } %>
  <% if (company.zalo) { %><a class="fab__btn fab__btn--zalo" href="https://zalo.me/<%= company.zalo %>" target="_blank" rel="noopener" aria-label="<%= t('common.chatZalo') %>" data-tip="<%= t('common.chatZalo') %>">
    <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path fill="#fff" d="M15 4C8.4 4 3 8.6 3 14.3c0 3.1 1.6 5.9 4.2 7.8-.2 1.3-.8 2.6-1.8 3.6 2 .1 3.8-.6 5.1-1.6 1.4.4 2.9.6 4.5.6 6.6 0 12-4.6 12-10.4S21.6 4 15 4z"/><text x="15" y="17.6" fill="#0068ff" font-family="Arial, sans-serif" font-size="7.6" font-weight="700" text-anchor="middle">Zalo</text></svg>
  </a><% } %>
  <a class="fab__btn fab__btn--call" href="tel:<%= (company.hotline || '').replace(/\s/g, '') %>" aria-label="<%= t('common.callNow') %>" data-tip="<%= t('common.callNow') %> <%= company.hotline || '' %>"><%- icon('phone', '', 22) %></a>
  <button class="fab__btn fab__btn--top" type="button" data-to-top aria-label="<%= t('common.backToTop') %>" hidden><%- icon('arrow', 'rot-up', 20) %></button>
</div>

<div class="toast" role="status" aria-live="polite" data-live-toast></div>

<script src="/js/main.js?v=3.2.0" defer nonce="<%= nonce %>"></script>
<script src="/js/motion.js?v=3.2.0" defer nonce="<%= nonce %>"></script>
</body>
</html>
