<%- include('_head') %>
<div class="panel pad" style="max-width:520px">
  <h2 class="h2">Đổi mật khẩu</h2>
  <p class="muted small" style="margin-bottom:16px">Đăng nhập: <b><%= user.email %></b></p>
  <form method="post" action="/admin/account">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="fld"><label>Mật khẩu hiện tại</label><input type="password" name="current" required autocomplete="current-password"></div>
    <div class="fld"><label>Mật khẩu mới <small>(tối thiểu 10 ký tự)</small></label><input type="password" name="next" required minlength="10" autocomplete="new-password"></div>
    <div class="fld"><label>Nhập lại mật khẩu mới</label><input type="password" name="confirm" required minlength="10" autocomplete="new-password"></div>
    <button class="btn btn--primary" type="submit">Đổi mật khẩu</button>
  </form>
</div>
<%- include('_foot') %>
