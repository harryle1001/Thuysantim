<%- include('_head') %>
<% const variants = H.parseJSON(item.variants, []); const isNew = !item.id; const imgSrc = item.image ? (/^(https?:)?\//.test(item.image) ? item.image : '/media/' + item.image) : (item.slug ? '/pack/' + item.slug + '.svg' : ''); %>
<form class="form" method="post" action="/admin/products/<%= isNew ? 'new' : item.id %>" enctype="multipart/form-data" data-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form__main">
    <div class="panel pad">
      <%- include('_langtabs') %>
      <%- include('_ml', { name: 'name', label: 'Tên sản phẩm *', value: item.name, required: true, hint: 'Gợi ý: “TÍM TÊN SP — mô tả ngắn”' }) %>
      <%- include('_ml', { name: 'summary', label: 'Tóm tắt', value: item.summary, area: true, rows: 3 }) %>
      <%- include('_ml', { name: 'description', label: 'Mô tả chi tiết', value: item.description, area: true, rows: 8, hint: 'Hỗ trợ Markdown: **đậm**, - danh sách, ## tiêu đề' }) %>
      <%- include('_ml', { name: 'composition', label: 'Thành phần', value: item.composition, area: true, rows: 3 }) %>
      <%- include('_ml', { name: 'usage_text', label: 'Công dụng', value: item.usage_text, area: true, rows: 3 }) %>
      <%- include('_ml', { name: 'dosage', label: 'Liều dùng', value: item.dosage, area: true, rows: 5, hint: 'Mỗi dòng là một mục' }) %>
    </div>

    <div class="panel pad">
      <h2 class="h2">Quy cách & giá (VNĐ)</h2>
      <div class="variants" data-variants>
        <% (variants.length ? variants : [{ label: '', price: '' }]).forEach(function (v) { %>
          <div class="variant-row">
            <input name="variant_label" value="<%= v.label %>" placeholder="VD: 1 kg">
            <input name="variant_price" value="<%= v.price %>" inputmode="numeric" placeholder="Giá, VD: 350000">
            <button type="button" class="icon-btn" data-remove-variant aria-label="Xóa"><%- icon('trash', '', 18) %></button>
          </div>
        <% }) %>
      </div>
      <button type="button" class="btn btn--ghost btn--sm" data-add-variant><%- icon('plus', '', 16) %> Thêm quy cách</button>
      <p class="muted small">Giá 0 = hiển thị “Yêu cầu báo giá”.</p>
    </div>
  </div>

  <aside class="form__side">
    <div class="panel pad sticky">
      <button class="btn btn--primary btn--block" type="submit"><%- icon('check', '', 18) %> <%= isNew ? 'Tạo sản phẩm' : 'Lưu thay đổi' %></button>
      <% if (!isNew) { %><a class="btn btn--ghost btn--block" href="/vi/products/<%= item.slug %>" target="_blank" rel="noopener"><%- icon('eye', '', 18) %> Xem trên web</a><% } %>
      <label class="switch"><input type="checkbox" name="is_active" value="1" <%= item.is_active ? 'checked' : '' %>><span></span> Đang bán</label>
      <label class="switch"><input type="checkbox" name="is_featured" value="1" <%= item.is_featured ? 'checked' : '' %>><span></span> Sản phẩm nổi bật</label>
    </div>
    <div class="panel pad">
      <div class="fld"><label>Ảnh sản phẩm</label>
        <div class="imgbox"><img src="<%= imgSrc || '/img/favicon.svg' %>" alt="" data-preview></div>
        <input type="file" name="image_file" accept="image/*" data-preview-input>
        <input name="image" value="<%= item.image || '' %>" placeholder="hoặc dán URL ảnh">
        <% if (item.image) { %><label class="check"><input type="checkbox" name="remove_image" value="1"> Xóa ảnh, dùng ảnh bao bì tự tạo</label><% } %>
        <small class="muted">Không có ảnh → hệ thống tự tạo ảnh bao bì theo màu chủ đạo.</small>
      </div>
      <div class="fld"><label>Màu chủ đạo bao bì</label><input type="color" name="color" value="<%= item.color || '#6d28d9' %>"></div>
    </div>
    <div class="panel pad">
      <div class="fld"><label>Danh mục</label>
        <select name="category_id"><option value="">— Không —</option><% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= item.category_id === c.id ? 'selected' : '' %>><%= tr(c.name) %></option><% }) %></select>
      </div>
      <div class="fld"><label>Đối tượng</label>
        <select name="species"><% [['all', 'Tôm & Cá'], ['shrimp', 'Tôm'], ['fish', 'Cá']].forEach(function (o) { %><option value="<%= o[0] %>" <%= item.species === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <div class="fld"><label>Nhãn</label>
        <select name="badge"><% [['', 'Không'], ['bestseller', 'Bán chạy'], ['new', 'Mới'], ['premium', 'Cao cấp']].forEach(function (o) { %><option value="<%= o[0] %>" <%= (item.badge || '') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
      </div>
      <div class="fld"><label>Mã SP (SKU)</label><input name="sku" value="<%= item.sku || '' %>"></div>
      <div class="fld"><label>Đường dẫn (slug)</label><input name="slug" value="<%= item.slug || '' %>" placeholder="tự tạo từ tên"></div>
      <div class="row2">
        <div class="fld"><label>Đánh giá</label><input name="rating" type="number" step="0.1" min="0" max="5" value="<%= item.rating || 5 %>"></div>
        <div class="fld"><label>Thứ tự</label><input name="sort_order" type="number" value="<%= item.sort_order || 0 %>"></div>
      </div>
    </div>
  </aside>
</form>
<% if (!isNew) { %>
  <form method="post" action="/admin/products/<%= item.id %>/delete" data-confirm="Xóa vĩnh viễn sản phẩm này?" class="danger-zone">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--danger" type="submit"><%- icon('trash', '', 16) %> Xóa sản phẩm</button>
  </form>
<% } %>
<template id="variant-tpl"><div class="variant-row"><input name="variant_label" placeholder="VD: 1 kg"><input name="variant_price" inputmode="numeric" placeholder="Giá"><button type="button" class="icon-btn" data-remove-variant aria-label="Xóa"><%- icon('trash', '', 18) %></button></div></template>
<%- include('_foot') %>
