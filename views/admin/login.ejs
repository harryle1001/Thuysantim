<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Đăng nhập quản trị — Thủy Sản Tím</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/admin.css?v=1.0.0">
</head>
<body class="login">
  <div class="login__art" aria-hidden="true">
    <div class="login__glow"></div>
    <div class="login__copy">
      <img src="/img/favicon.svg" alt="" width="56" height="56">
      <h2>THỦY SẢN TÍM</h2>
      <p>Khoa học cho ao nuôi bền vững</p>
    </div>
  </div>
  <main class="login__panel">
    <form class="login__form" method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h1>Đăng nhập</h1>
      <p class="muted">Trang quản trị website Thủy Sản Tím</p>
      <% if (error) { %><div class="flash flash--error"><%= error %></div><% } %>
      <div class="fld"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="username" value="<%= email %>" autofocus></div>
      <div class="fld"><label for="password">Mật khẩu</label><input id="password" name="password" type="password" required autocomplete="current-password"></div>
      <button class="btn btn--primary btn--block" type="submit">Đăng nhập</button>
      <a class="muted small" href="/vi">← Về trang chủ</a>
    </form>
  </main>
</body>
</html>
