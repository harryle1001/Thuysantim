# =====================================================================
# THỦY SẢN TÍM — biến môi trường
# Local: copy file này thành .env.  Hostinger: nhập trong hPanel → Node.js → Environment variables.
# KHÔNG commit file .env lên GitHub.
# =====================================================================

NODE_ENV=production
# Hostinger tự cấp PORT; chỉ đặt khi chạy local
# PORT=3000

# Địa chỉ website (không có dấu / ở cuối) — dùng cho SEO, sitemap, link thanh toán
BASE_URL=https://thuysantim.vn

# Chuỗi ngẫu nhiên dài ≥ 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- MySQL (hPanel → Databases → MySQL Databases) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_thuysantim
DB_USER=u123456789_tst
DB_PASSWORD=

# Tự tạo bảng & nạp dữ liệu mẫu khi khởi động (an toàn: không ghi đè dữ liệu đã có)
AUTO_MIGRATE=true
AUTO_SEED=true

# ---------- Tài khoản quản trị đầu tiên (chỉ dùng khi DB chưa có user) ----------
ADMIN_EMAIL=admin@thuysantim.vn
ADMIN_PASSWORD=

# ---------- Email thông báo (Hostinger Email: smtp.hostinger.com, cổng 465) ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Email nhận thông báo đơn hàng / liên hệ mới
MAIL_NOTIFY=

# ---------- VNPay (để trống = ẩn phương thức VNPay) ----------
VNP_TMN_CODE=
VNP_HASH_SECRET=
# Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html — Production: https://pay.vnpay.vn/vpcpay.html
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ---------- MoMo (để trống = ẩn phương thức MoMo) ----------
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Test: https://test-payment.momo.vn/v2/gateway/api/create — Production: https://payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
